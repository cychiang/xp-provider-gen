# ====================================================================================
# Setup Project
#
# This Makefile is yours: set the project variables here, above the include,
# and add your own targets at the bottom. The build pipeline — including the
# Terraform CLI version this tool pins and its download and schema logic —
# lives in hack/xp-provider-gen.mk, which xp-provider-gen owns and refreshes on
# `xp-provider-gen update`; do not edit that file. docs/ownership.md lists
# which files are yours.

PROJECT_NAME := {{ .ProviderName }}
PROJECT_REPO := {{ .Repo }}

export TERRAFORM_PROVIDER_SOURCE ?= {{ .TerraformProvider }}
export TERRAFORM_PROVIDER_REPO ?= {{ .TerraformProviderRepo }}
export TERRAFORM_PROVIDER_VERSION ?= {{ .TerraformProviderVersion }}
export TERRAFORM_PROVIDER_DOWNLOAD_NAME ?= terraform-provider-{{ .TerraformProviderName }}
export TERRAFORM_NATIVE_PROVIDER_BINARY ?= terraform-provider-{{ .TerraformProviderName }}_v{{ .TerraformProviderVersion }}_x5
export TERRAFORM_DOCS_PATH ?= {{ .TerraformDocsPath }}

PLATFORMS ?= linux_amd64 linux_arm64

include hack/xp-provider-gen.mk

