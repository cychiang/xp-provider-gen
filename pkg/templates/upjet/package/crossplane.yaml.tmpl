apiVersion: meta.pkg.crossplane.io/v1alpha1
kind: Provider
metadata:
  name: {{ .ProviderName }}
  annotations:
    meta.crossplane.io/maintainer: {{ .ProviderName }} Maintainers <maintainers@example.com>
    meta.crossplane.io/source: {{ .Repo }}
    meta.crossplane.io/license: Apache-2.0
    meta.crossplane.io/description: |
      {{ .ProviderName }} is a Crossplane provider.
    meta.crossplane.io/readme: |
      The `{{ .ProviderName }}` provider can be installed into a Crossplane control plane and adds:

      * Custom Resource Definitions (CRDs) that model the resources it manages
      * Controllers that reconcile those resources toward the desired state their CRDs declare

spec:
  capabilities:
  - safe-start
  controller:
    image: {{ .Repo }}:latest
