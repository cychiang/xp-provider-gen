# Chainsaw behavior test scaffolded by xp-provider-gen create-test.
# Docs: https://kyverno.github.io/chainsaw/
apiVersion: chainsaw.kyverno.io/v1alpha1
kind: Test
metadata:
  name: {{ .TestName }}
spec:
  timeouts:
    apply: 1m
    assert: 2m
    delete: 2m
    # cleanup (this Test's own removal of what it created) is a separate
    # chainsaw timeout from delete above, and defaults to just 30s. A
    # Terraform-CLI-backed (upjet) provider only confirms a deletion on its
    # next reconcile after calling Delete — measured ~36s in practice — so
    # the 30s default cuts it close; native providers reconcile fast enough
    # that this is headroom, not a requirement.
    cleanup: 2m
  steps:
    - name: {{ .Resource.Kind }} becomes Ready
      try:
        - apply:
            resource:
              apiVersion: {{ .APIVersion }}
              kind: {{ .Resource.Kind }}
              metadata:
                name: behavior-{{ .TestName }}
                namespace: {{ .Namespace }}
              # .Spec below is pre-indented to specIndent (pkg/plugins/crossplane/v2/example_manifest.go) — keep them in step.
              spec:
{{ .Spec }}
        - assert:
            resource:
              apiVersion: {{ .APIVersion }}
              kind: {{ .Resource.Kind }}
              metadata:
                name: behavior-{{ .TestName }}
                namespace: {{ .Namespace }}
              status:
                ((conditions[?type == 'Ready'])[0]):
                  status: "True"
    # TODO: this scaffold only proves the resource reconciles. Replace or
    # extend the steps with the behavior you actually want to pin — error
    # paths, drift, pause, config resolution. See the pause test in
    # test/behavior/ for a worked multi-step example.
