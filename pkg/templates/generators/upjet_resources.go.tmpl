{{ .Boilerplate }}

// Code generated by xp-provider-gen. DO NOT EDIT.

package config

import (
	ujconfig "github.com/crossplane/upjet/v2/pkg/config"
{{- range .Resources }}
	{{ .Alias }} "{{ .Path }}"
{{- end }}
)

// Configurators is every per-resource configurator in this provider, in the
// order `create api` added them. config/provider.go applies them all.
var Configurators = []func(*ujconfig.Provider){
{{- range .Resources }}
	{{ .Alias }}.Configure,
{{- end }}
}

// ResourceNames is the upjet include list: only these Terraform resources are
// generated. Each entry is anchored so it matches exactly one resource.
func ResourceNames() []string {
	return []string{
{{- range .Resources }}
		{{ .Alias }}.TerraformResource + "$",
{{- end }}
	}
}
