mkdir -p "${WORK}"
export KUBECONFIG="${WORK}/kubeconfig"

cleanup() {
    code=$?
    if [ $code -ne 0 ]; then
        echo "--- provider package status ---"
        "${KUBECTL}" describe provider.pkg.crossplane.io "${PROJECT_NAME}" 2>/dev/null | tail -20 || true
    fi
