#!/usr/bin/env bash
# // Code generated by xp-provider-gen. DO NOT EDIT.
#
# Reconcile-path integration test, run by `make test-integration`.
#
# Creates a throwaway kind cluster, installs this provider's CRDs, runs the
# controller out-of-cluster against it, applies every example manifest, and
# waits for each managed resource to become Ready — proving the code in your
# seam files (client.go, options.go, external.go) reconciles for real. Then
# deletes the examples and waits for finalizers, proving the Delete path.
#
# It never touches your normal kubeconfig: the cluster lives in its own
# KUBECONFIG under .work/ and is deleted on exit (set skipcleanup=true to keep
# it for debugging). The full packaged flow (image, xpkg, Crossplane install,
# uptest + chainsaw) is `make e2e`.
set -euo pipefail

projectdir="$( cd "$( dirname "${BASH_SOURCE[0]}")"/../.. && pwd )"

# Tool paths (KIND, KUBECTL, ...) and project facts come from the build system.
eval "$(make --no-print-directory -C "${projectdir}" build.vars)"

# The name comes from the Makefile — the single source for cluster names.
CLUSTER="${INTEGRATION_CLUSTER_NAME:?run via 'make test-integration'}"
WORK="${WORK_DIR}/e2e"
mkdir -p "${WORK}"
export KUBECONFIG="${WORK}/kubeconfig"

CONTROLLER_PID=""
cleanup() {
    code=$?
    if [ -n "${CONTROLLER_PID}" ]; then
        kill "${CONTROLLER_PID}" >/dev/null 2>&1 || true
    fi
    if [ $code -ne 0 ]; then
        echo "--- controller log (last 40 lines) ---"
        tail -40 "${WORK}/controller.log" 2>/dev/null || true
    fi
    if [ "${skipcleanup:-}" != "true" ]; then
        "${KIND}" delete cluster --name "${CLUSTER}" >/dev/null 2>&1 || true
    fi
    exit $code
}
trap cleanup EXIT

echo ">>> creating kind cluster ${CLUSTER}"
"${KIND}" delete cluster --name "${CLUSTER}" >/dev/null 2>&1 || true
"${KIND}" create cluster --name "${CLUSTER}" --kubeconfig "${KUBECONFIG}" --wait 5m

echo ">>> installing CRDs"
"${KUBECTL}" apply -R -f "${projectdir}/package/crds"
"${KUBECTL}" wait crd --all --for condition=Established --timeout=60s

echo ">>> starting the controller out-of-cluster"
(cd "${projectdir}" && go build -o "${WORK}/provider" ./cmd/provider)
"${WORK}/provider" --debug >"${WORK}/controller.log" 2>&1 &
CONTROLLER_PID=$!

echo ">>> applying provider config examples"
"${KUBECTL}" apply -f "${projectdir}/examples/provider/config.yaml"

echo ">>> applying managed resource examples and waiting for Ready"
shopt -s nullglob
examples=()
for f in "${projectdir}"/examples/*/*.yaml; do
    case "$f" in */examples/provider/*) continue ;; esac
    examples+=("$f")
    "${KUBECTL}" apply -f "$f"
done
if [ ${#examples[@]} -eq 0 ]; then
    echo "no managed resource examples found (no APIs created yet) — nothing to reconcile"
else
    for f in "${examples[@]}"; do
        "${KUBECTL}" wait -f "$f" --for condition=Ready --timeout=180s
    done

    echo ">>> deleting managed resource examples (exercises the Delete path)"
    for f in "${examples[@]}"; do
        "${KUBECTL}" delete -f "$f" --wait --timeout=120s
    done
fi

echo ">>> e2e succeeded: examples reconciled to Ready and deleted cleanly"
