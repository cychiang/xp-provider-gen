{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":rebaseStalePrs",
    ":semanticCommitTypeAll(chore)"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "reviewers": ["cychiang"],
  "assignees": ["cychiang"],
  "prConcurrentLimit": 8,
  "prHourlyLimit": 3,
  "separateMajorMinor": true,
  "separateMultipleMajor": true,
  "separateMinorPatch": false,
  "rangeStrategy": "bump",
  "semanticCommits": "enabled",
  "semanticCommitType": "deps",
  "branchPrefix": "renovate/",
  "branchTopic": "{{{depNameSanitized}}}-{{{newMajor}}}x",
  "prTitle": "{{semanticCommitType}}{{#if semanticCommitScope}}({{semanticCommitScope}}){{/if}}: {{commitMessageAction}} {{commitMessageTopic}} {{commitMessageExtra}}",
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "Security updates - immediate, high priority",
      "matchPackagePatterns": ["*"],
      "vulnerabilityAlerts": true,
      "automerge": false,
      "addLabels": ["security", "dependencies", "urgent"],
      "prPriority": 25,
      "semanticCommitType": "fix",
      "semanticCommitScope": "security",
      "schedule": ["at any time"],
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Critical infrastructure - Kubebuilder",
      "matchPackagePatterns": ["sigs.k8s.io/kubebuilder"],
      "addLabels": ["kubebuilder", "dependencies", "infrastructure"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "kubebuilder",
      "prPriority": 20,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Go modules - major updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["go", "dependencies", "major-update"],
      "prPriority": 15,
      "semanticCommitType": "deps",
      "semanticCommitScope": "go",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Go modules - minor/patch updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": false,
      "addLabels": ["go", "dependencies"],
      "prPriority": 10,
      "semanticCommitType": "deps",
      "semanticCommitScope": "go",
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Go development tools - safe automerge",
      "matchManagers": ["gomod"],
      "matchPackagePatterns": [
        "mvdan.cc/gofumpt",
        "github.com/golangci/golangci-lint",
        "golang.org/x/tools"
      ],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["go", "tools", "dependencies", "automerge"],
      "semanticCommitType": "build",
      "semanticCommitScope": "tools",
      "minimumReleaseAge": "3 days",
      "schedule": ["before 6am on the first day of the month"]
    },
    {
      "description": "Testing libraries - safe automerge for patches",
      "matchPackagePatterns": [
        "github.com/stretchr/testify",
        "github.com/onsi/ginkgo",
        "github.com/onsi/gomega"
      ],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["testing", "dependencies", "automerge"],
      "semanticCommitType": "test",
      "semanticCommitScope": "deps",
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Kubernetes API packages",
      "matchPackagePatterns": ["k8s.io/api", "k8s.io/client-go", "k8s.io/apimachinery"],
      "groupName": "kubernetes-api",
      "addLabels": ["kubernetes", "api", "dependencies"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "k8s-api",
      "prPriority": 12,
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "Kubernetes tooling",
      "matchPackagePatterns": ["k8s.io/code-generator", "k8s.io/controller-tools", "sigs.k8s.io/controller-runtime"],
      "groupName": "kubernetes-tooling",
      "addLabels": ["kubernetes", "tooling", "dependencies"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "k8s-tools",
      "prPriority": 11,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Crossplane ecosystem",
      "matchPackagePatterns": ["github.com/crossplane"],
      "groupName": "crossplane packages",
      "addLabels": ["crossplane", "dependencies"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "crossplane",
      "prPriority": 13,
      "minimumReleaseAge": "5 days"
    },
    {
      "description": "GitHub Actions - minor/patch automerge",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["github-actions", "dependencies", "automerge"],
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions",
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "GitHub Actions - major updates: automerge after a 14-day soak once CI passes. Actions are SHA-pinned and gated by the full PR CI (lint/test/e2e/build); only release.yml-exclusive actions aren't exercised by PR CI, so watch the first release after a docker/* action major.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["github-actions", "dependencies", "major-update", "automerge"],
      "prPriority": 8,
      "semanticCommitType": "ci",
      "semanticCommitScope": "actions",
      "minimumReleaseAge": "14 days"
    },
    {
      "description": "Docker images - conservative updates",
      "matchManagers": ["dockerfile"],
      "automerge": false,
      "addLabels": ["docker", "dependencies"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "docker",
      "prPriority": 6,
      "minimumReleaseAge": "10 days"
    },
    {
      "description": "Dockerfile's golang base image tag is not an independent dependency: it must equal pkg/versions/dependencies.yaml's go_version (enforced in CI by scripts/check-go-version, see .github/workflows/go-version.yml). Disable the built-in dockerfile manager for it so Renovate stops proposing it on its own datasource/schedule (e.g. PR #151) - the customManager below tracks it together with go_version instead, in one PR.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["golang"],
      "enabled": false
    },
    {
      "description": "Generated-provider framework deps (pkg/versions/dependencies.yaml) - bump together so crossplane-runtime, crossplane/apis, controller-runtime, and k8s.io/* stay mutually compatible (individual bumps break the e2e)",
      "matchFileNames": ["pkg/versions/dependencies.yaml"],
      "groupName": "provider framework dependencies",
      "addLabels": ["dependencies", "provider-framework"],
      "semanticCommitType": "deps",
      "semanticCommitScope": "provider",
      "prPriority": 14,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "upjet/v2 is pinned to a post-v2.4.0 commit on purpose: released v2.4.0 imports crossplane-runtime/v2/apis/common/v1, which crossplane-runtime removed in its own v2.4.0, so make generate fails in a scaffolded upjet provider. With rollbackPrs enabled Renovate treats the pseudo-version as invalid and proposes the release, which is a downgrade that rolls the fix back (PRs #134, #152). Only accept versions above v2.4.0, so a genuine v2.4.1 is still proposed.",
      "matchPackageNames": ["github.com/crossplane/upjet/v2"],
      "allowedVersions": ">v2.4.0"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track generated-provider dependency versions in pkg/versions/dependencies.yaml",
      "managerFilePatterns": ["pkg/versions/dependencies.yaml"],
      "matchStrings": ["module:\\s*(?<depName>\\S+)\\s+version:\\s*(?<currentValue>\\S+)"],
      "datasourceTemplate": "go"
    },
    {
      "customType": "regex",
      "description": "Track the Go version as ONE dependency across pkg/versions/dependencies.yaml's go_version and the Dockerfile's golang base image tag, so a bump only ever proposes both together in a single PR - never the Dockerfile alone (that drift is what broke five times this week). go.mod's own `go` directive is not tracked here: this repo's config does not otherwise enable Renovate on go.mod's go directive, so there is nothing to converge with; scripts/check-go-version still enforces it against go_version in CI regardless of who edits it.",
      "managerFilePatterns": ["pkg/versions/dependencies.yaml", "Dockerfile"],
      "matchStrings": [
        "go_version:\\s*[\"'](?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']",
        "FROM golang:(?<currentValue>\\d+\\.\\d+\\.\\d+)-alpine"
      ],
      "depNameTemplate": "generated-provider-go-version",
      "datasourceTemplate": "golang-version"
    }
  ],
  "osvVulnerabilityAlerts": true,
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "🤖 Dependency Dashboard",
  "dependencyDashboardHeader": "This issue lists Renovate updates and detected dependencies. Read the [Dependency Dashboard](https://docs.renovatebot.com/key-concepts/dashboard/) docs to learn more.",
  "dependencyDashboardLabels": ["dependencies", "renovate"],
  "configWarningReuseIssue": false,
  "rollbackPrs": true,
  "suppressNotifications": ["prIgnoreNotification"]
}
